<?xml version="1.0"?>
<robot name="xarm">
  <group name="gripper">
    <joint name="gripper_1_joint" />
    <joint name="gripper_2_joint" />
  </group>
  <group name="xarm">
    <chain base_link="base_link" tip_link="gripper_centor_link" />
  </group>

  <group_state name="Open_gripper" group="gripper">
    <joint name="gripper_1_joint" value="0.68" />
    <joint name="gripper_2_joint" value="0.68" />
  </group_state>
  <group_state name="Close_gripper" group="gripper">
    <joint name="gripper_1_joint" value="0" />
    <joint name="gripper_2_joint" value="0" />
  </group_state>
  <group_state name="Home" group="xarm">
    <joint name="arm_1_joint" value="0" />
    <joint name="arm_2_joint" value="0" />
    <joint name="arm_3_joint" value="0" />
    <joint name="arm_4_joint" value="0" />
    <joint name="arm_5_joint" value="0" />
    <joint name="arm_6_joint" value="0" />
  </group_state>
  <group_state name="Down" group="xarm">
    <joint name="arm_1_joint" value="0" />
    <joint name="arm_2_joint" value="-1" />
    <joint name="arm_3_joint" value="0" />
    <joint name="arm_4_joint" value="-1.5" />
    <joint name="arm_5_joint" value="0" />
    <joint name="arm_6_joint" value="-0.55" />
  </group_state>

  <end_effector name="hand" parent_link="arm_6_link" group="gripper" parent_group="xarm" />

  <disable_collisions link1="arm_1_link" link2="arm_2_link" reason="Adjacent" />
  <disable_collisions link1="arm_1_link" link2="arm_3_link" reason="Never" />
  <disable_collisions link1="arm_1_link" link2="arm_4_link" reason="Never" />
  <disable_collisions link1="arm_1_link" link2="arm_5_link" reason="Never" />
  <disable_collisions link1="arm_1_link" link2="arm_6_link" reason="Never" />
  <disable_collisions link1="arm_1_link" link2="base_link" reason="Adjacent" />
  <disable_collisions link1="arm_1_link" link2="gripper_1_link" reason="Never" />
  <disable_collisions link1="arm_1_link" link2="gripper_2_link" reason="Never" />
  <disable_collisions link1="arm_2_link" link2="arm_3_link" reason="Adjacent" />
  <disable_collisions link1="arm_2_link" link2="arm_4_link" reason="Never" />
  <disable_collisions link1="arm_2_link" link2="arm_5_link" reason="Never" />
  <disable_collisions link1="arm_2_link" link2="arm_6_link" reason="Never" />
  <disable_collisions link1="arm_2_link" link2="gripper_1_link" reason="Never" />
  <disable_collisions link1="arm_2_link" link2="gripper_2_link" reason="Never" />
  <disable_collisions link1="arm_3_link" link2="arm_4_link" reason="Adjacent" />
  <disable_collisions link1="arm_3_link" link2="arm_5_link" reason="Never" />
  <disable_collisions link1="arm_3_link" link2="arm_6_link" reason="Never" />
  <disable_collisions link1="arm_3_link" link2="gripper_1_link" reason="Never" />
  <disable_collisions link1="arm_3_link" link2="gripper_2_link" reason="Never" />
  <disable_collisions link1="arm_4_link" link2="arm_5_link" reason="Adjacent" />
  <disable_collisions link1="arm_4_link" link2="arm_6_link" reason="Never" />
  <disable_collisions link1="arm_4_link" link2="base_link" reason="Never" />
  <disable_collisions link1="arm_4_link" link2="gripper_1_link" reason="Never" />
  <disable_collisions link1="arm_4_link" link2="gripper_2_link" reason="Never" />
  <disable_collisions link1="arm_5_link" link2="arm_6_link" reason="Adjacent" />
  <disable_collisions link1="arm_5_link" link2="gripper_1_link" reason="Never" />
  <disable_collisions link1="arm_5_link" link2="gripper_2_link" reason="Never" />
  <disable_collisions link1="arm_6_link" link2="gripper_1_link" reason="Adjacent" />
  <disable_collisions link1="arm_6_link" link2="gripper_2_link" reason="Adjacent" />
  <disable_collisions link1="gripper_1_link" link2="gripper_2_link" reason="Never" />
</robot>
