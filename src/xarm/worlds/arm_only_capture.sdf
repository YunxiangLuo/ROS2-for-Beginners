<?xml version="1.0"?>
<sdf version="1.9">
  <world name="arm_only">
    <physics name="default_physics" type="ode">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.06 0.08 0.10 1</background>
      <sky />
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.4 -0.8</direction>
      <cast_shadows>true</cast_shadows>
    </light>

    <model name="capture_floor">
      <static>true</static>
      <pose>0 0 -0.05 0 0 0</pose>
      <link name="floor_link">
        <visual name="floor_visual">
          <geometry>
            <box>
              <size>4 4 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.025 0.03 0.04 1</ambient>
            <diffuse>0.04 0.05 0.07 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="capture_camera">
      <static>true</static>
      <pose>1.2 -1.6 0.9 0 0.173 2.214</pose>
      <link name="camera_link">
        <sensor name="xarm_capture_camera" type="camera">
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <visualize>false</visualize>
          <topic>xarm_capture/image</topic>
          <camera>
            <horizontal_fov>1.0</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>10.0</far>
            </clip>
          </camera>
          <plugin
            filename="gz-sim-camera-video-recorder-system"
            name="gz::sim::systems::CameraVideoRecorder">
            <service>xarm_capture/record_video</service>
          </plugin>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
