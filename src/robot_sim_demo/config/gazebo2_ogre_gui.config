<?xml version="1.0"?>
<!--
  WSLg's software-rendered Vulkan texture export can leave MinimalScene blank.
  This standalone GUI config keeps the display and rendering APIs on classic
  OpenGL/OGRE while the Gazebo server continues to run the world normally.
   The camera remains fully manual: wheel zooms, dragging rotates or pans,
   with no automatic entity-following camera.
-->
<window>
  <width>1200</width>
  <height>720</height>
  <default_exit_action>close_gui</default_exit_action>
  <dialog_on_exit>false</dialog_on_exit>
</window>

<plugin filename="MinimalScene" name="Campus Top View">
  <gz-gui>
    <title>Campus Top View</title>
    <property type="bool" key="showTitleBar">false</property>
    <property type="string" key="state">docked</property>
  </gz-gui>
  <engine>ogre</engine>
  <scene>scene</scene>
  <ambient_light>0.38 0.42 0.46</ambient_light>
  <background_color>0.05 0.08 0.12</background_color>
  <camera_pose>31 18 95 0 1.32 0</camera_pose>
  <anti_aliasing>0</anti_aliasing>
  <camera_clip>
    <near>0.10</near>
    <far>220.0</far>
  </camera_clip>
</plugin>

<!-- Synchronizes Gazebo entity visuals into MinimalScene. -->
<plugin filename="GzSceneManager" name="Scene Manager">
  <gz-gui>
    <property key="resizable" type="bool">false</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
  </gz-gui>
</plugin>

<plugin filename="InteractiveViewControl" name="Interactive view control">
  <gz-gui>
    <property key="resizable" type="bool">false</property>
    <property key="state" type="string">floating</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="showTitleBar" type="bool">false</property>
  </gz-gui>
</plugin>

<!-- Standard Gazebo interaction helpers; they receive mouse events from the 3D view. -->
<plugin filename="EntityContextMenuPlugin" name="Entity context menu">
  <gz-gui>
    <property key="resizable" type="bool">false</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
  </gz-gui>
</plugin>

<plugin filename="MarkerManager" name="Marker manager">
  <gz-gui>
    <property key="resizable" type="bool">false</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
  </gz-gui>
</plugin>

<plugin filename="SelectEntities" name="Select Entities">
  <gz-gui>
    <property key="resizable" type="bool">false</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
  </gz-gui>
</plugin>

<plugin filename="VisualizationCapabilities" name="Visualization Capabilities">
  <gz-gui>
    <property key="resizable" type="bool">false</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
  </gz-gui>
</plugin>

<plugin filename="WorldControl" name="World control">
  <gz-gui>
    <title>World control</title>
    <property type="bool" key="showTitleBar">false</property>
    <property type="bool" key="resizable">false</property>
    <property type="double" key="height">58</property>
    <property type="double" key="z">1</property>
    <property type="string" key="state">floating</property>
    <anchors target="Campus Top View">
      <line own="left" target="left"/>
      <line own="bottom" target="bottom"/>
    </anchors>
  </gz-gui>
  <play_pause>true</play_pause>
  <step>true</step>
  <start_paused>false</start_paused>
  <use_event>true</use_event>
</plugin>

<!-- Expose /gui/screenshot for reproducible scene captures. -->
<plugin filename="Screenshot" name="Screenshot" />
