<?xml version="1.0"?>

<window>
  <width>1280</width>
  <height>800</height>
  <style
    material_theme="Dark"
    material_primary="DeepOrange"
    material_accent="LightBlue"
    toolbar_color_light="#202a33"
    toolbar_text_color_light="#e8f0f4"
    toolbar_color_dark="#111820"
    toolbar_text_color_dark="#e8f0f4"
    plugin_toolbar_color_light="#263746"
    plugin_toolbar_text_color_light="#e8f0f4"
    plugin_toolbar_color_dark="#1a2732"
    plugin_toolbar_text_color_dark="#d9e7ed"
  />
  <menus>
    <drawer default="false" />
  </menus>
</window>

<!-- The supporting scene plugins are hidden infrastructure; 3D View is the
     only visible Gazebo panel. -->
<plugin filename="MinimalScene" name="3D View">
  <gz-gui>
    <title>3D View</title>
    <property type="bool" key="showTitleBar">false</property>
    <property type="string" key="state">docked</property>
  </gz-gui>
  <engine>ogre2</engine>
  <scene>scene</scene>
  <ambient_light>0.58 0.58 0.58</ambient_light>
  <background_color>0.035 0.055 0.075</background_color>
  <!-- Top-down view: camera above scene center, low enough to see robot clearly. -->
  <camera_pose>-1.5 -1.5 2.5 0 0.8 0.785</camera_pose>
</plugin>

<plugin filename="GzSceneManager" name="Scene Manager">
  <gz-gui>
    <property key="resizable" type="bool">false</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
  </gz-gui>
</plugin>
<plugin filename="InteractiveViewControl" name="Interactive view control">
  <gz-gui>
    <property key="resizable" type="bool">false</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
  </gz-gui>
</plugin>
<plugin filename="CameraTracking" name="Camera Tracking">
