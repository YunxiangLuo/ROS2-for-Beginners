<?xml version="1.0"?>
<sdf version="1.9">
  <model name="wheeltec_robot">
    <static>false</static>
    <self_collide>false</self_collide>
    <allow_auto_disable>false</allow_auto_disable>

    <link name="base_link">
      <inertial>
        <pose>0 0 -0.01 0 0 0</pose>
        <mass>15.0</mass>
        <inertia>
          <ixx>0.05</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.08</iyy><iyz>0</iyz><izz>0.10</izz>
        </inertia>
      </inertial>
      <collision name="base_collision">
        <pose>0 0 0.03 0 0 0</pose>
        <geometry><box><size>0.20 0.14 0.04</size></box></geometry>
        <surface>
          <friction>
            <ode><mu>0</mu><mu2>0</mu2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="base_visual">
        <geometry><mesh><uri>model://wheeltec_robot/meshes/base_link.STL</uri></mesh></geometry>
        <material><ambient>0.025 0.040 0.055 1</ambient><diffuse>0.065 0.095 0.125 1</diffuse><specular>0.55 0.70 0.78 1</specular><shininess>75</shininess></material>
      </visual>
      <visual name="front_visual">
        <pose>0.14383 -0.000013 0.01 0 0 0</pose>
        <geometry><mesh><uri>model://wheeltec_robot/meshes/front_link.STL</uri></mesh></geometry>
        <material><ambient>0.48 0.055 0.012 1</ambient><diffuse>0.82 0.16 0.025 1</diffuse><specular>0.80 0.38 0.12 1</specular><shininess>55</shininess></material>
      </visual>
      <visual name="controller_visual">
        <pose>-0.000357 -0.04684 0.0515 0 0 0</pose>
        <geometry><mesh><uri>model://wheeltec_robot/meshes/controller_link.STL</uri></mesh></geometry>
        <material><ambient>0.035 0.050 0.065 1</ambient><diffuse>0.10 0.14 0.18 1</diffuse><specular>0.50 0.68 0.78 1</specular><shininess>70</shininess></material>
      </visual>
      <visual name="camera_visual">
        <pose>0.11365 0.000165 0.0762 0 0 0</pose>
        <geometry><mesh><uri>model://wheeltec_robot/meshes/camera_link.STL</uri></mesh></geometry>
        <material><ambient>0.46 0.50 0.56 1</ambient><diffuse>0.68 0.73 0.80 1</diffuse><specular>0.98 0.98 1.00 1</specular><shininess>100</shininess></material>
      </visual>
      <visual name="camera_lens">
        <pose>0.143 0.000165 0.0762 0 1.5708 0</pose>
        <geometry><cylinder><radius>0.014</radius><length>0.012</length></cylinder></geometry>
        <material><ambient>0.005 0.008 0.012 1</ambient><diffuse>0.015 0.025 0.035 1</diffuse><specular>0.35 0.50 0.62 1</specular><shininess>90</shininess></material>
      </visual>
      <visual name="camera_status_ring">
        <pose>0.150 0.000165 0.0762 0 1.5708 0</pose>
        <geometry><cylinder><radius>0.018</radius><length>0.004</length></cylinder></geometry>
        <material><ambient>0.00 0.16 0.22 1</ambient><diffuse>0.00 0.42 0.60 1</diffuse><emissive>0.00 0.18 0.28 1</emissive></material>
      </visual>
    </link>

    <link name="lb_link">
      <pose>-0.069657 0.07975 0.0162 0 0 0</pose>
      <inertial><mass>0.5</mass><inertia><ixx>0.00016</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.00028</iyy><iyz>0</iyz><izz>0.00016</izz></inertia></inertial>
      <collision name="lb_collision">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.033</radius><length>0.025</length></cylinder></geometry>
        <surface>
          <friction>
            <ode><mu>1.2</mu><mu2>0.3</mu2><fdir1>1 0 0</fdir1><slip1>0.01</slip1><slip2>0.02</slip2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="lb_visual"><geometry><mesh><uri>model://wheeltec_robot/meshes/lb_link.STL</uri></mesh></geometry><material><ambient>0.012 0.015 0.020 1</ambient><diffuse>0.025 0.032 0.042 1</diffuse><specular>0.12 0.16 0.20 1</specular><shininess>35</shininess></material></visual>
      <visual name="lb_hub"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.012</radius><length>0.028</length></cylinder></geometry><material><ambient>0.28 0.32 0.36 1</ambient><diffuse>0.52 0.58 0.64 1</diffuse><specular>0.90 0.95 1.00 1</specular><shininess>90</shininess></material></visual>
    </link>
    <link name="rb_link">
      <pose>-0.069657 -0.079776 0.0162 0 0 0</pose>
      <inertial><mass>0.5</mass><inertia><ixx>0.00016</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.00028</iyy><iyz>0</iyz><izz>0.00016</izz></inertia></inertial>
      <collision name="rb_collision">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.033</radius><length>0.025</length></cylinder></geometry>
        <surface>
          <friction>
            <ode><mu>1.2</mu><mu2>0.3</mu2><fdir1>1 0 0</fdir1><slip1>0.01</slip1><slip2>0.02</slip2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="rb_visual"><geometry><mesh><uri>model://wheeltec_robot/meshes/rb_link.STL</uri></mesh></geometry><material><ambient>0.012 0.015 0.020 1</ambient><diffuse>0.025 0.032 0.042 1</diffuse><specular>0.12 0.16 0.20 1</specular><shininess>35</shininess></material></visual>
      <visual name="rb_hub"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.012</radius><length>0.028</length></cylinder></geometry><material><ambient>0.28 0.32 0.36 1</ambient><diffuse>0.52 0.58 0.64 1</diffuse><specular>0.90 0.95 1.00 1</specular><shininess>90</shininess></material></visual>
    </link>
    <joint name="lb_joint" type="revolute"><parent>base_link</parent><child>lb_link</child><axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit><dynamics><damping>0.01</damping><friction>0.0</friction></dynamics></axis></joint>
    <joint name="rb_joint" type="revolute"><parent>base_link</parent><child>rb_link</child><axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit><dynamics><damping>0.01</damping><friction>0.0</friction></dynamics></axis></joint>

    <link name="left_link">
      <pose>0.073593 0.051987 0.022 0 0 0</pose>
      <visual name="left_visual"><geometry><mesh><uri>model://wheeltec_robot/meshes/left_link.STL</uri></mesh></geometry><material><ambient>0.025 0.040 0.055 1</ambient><diffuse>0.075 0.11 0.145 1</diffuse><specular>0.55 0.70 0.78 1</specular><shininess>70</shininess></material></visual>
    </link>
    <link name="right_link">
      <pose>0.073593 -0.052013 0.022 0 0 0</pose>
      <visual name="right_visual"><geometry><mesh><uri>model://wheeltec_robot/meshes/right_link.STL</uri></mesh></geometry><material><ambient>0.025 0.040 0.055 1</ambient><diffuse>0.075 0.11 0.145 1</diffuse><specular>0.55 0.70 0.78 1</specular><shininess>70</shininess></material></visual>
    </link>
    <link name="lf_link">
      <pose>0.073593 0.082113 0.0162 0 0 0</pose>
      <inertial><mass>0.5</mass><inertia><ixx>0.00016</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.00028</iyy><iyz>0</iyz><izz>0.00016</izz></inertia></inertial>
      <collision name="lf_collision">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.033</radius><length>0.025</length></cylinder></geometry>
        <surface>
          <friction>
            <ode><mu>1.2</mu><mu2>0.3</mu2><fdir1>1 0 0</fdir1><slip1>0.01</slip1><slip2>0.02</slip2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="lf_visual"><geometry><mesh><uri>model://wheeltec_robot/meshes/lf_link.STL</uri></mesh></geometry><material><ambient>0.012 0.015 0.020 1</ambient><diffuse>0.025 0.032 0.042 1</diffuse><specular>0.12 0.16 0.20 1</specular><shininess>35</shininess></material></visual>
      <visual name="lf_hub"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.012</radius><length>0.028</length></cylinder></geometry><material><ambient>0.28 0.32 0.36 1</ambient><diffuse>0.52 0.58 0.64 1</diffuse><specular>0.90 0.95 1.00 1</specular><shininess>90</shininess></material></visual>
    </link>
    <link name="rf_link">
      <pose>0.073593 -0.082139 0.0162 0 0 0</pose>
      <inertial><mass>0.5</mass><inertia><ixx>0.00016</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.00028</iyy><iyz>0</iyz><izz>0.00016</izz></inertia></inertial>
      <collision name="rf_collision">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.033</radius><length>0.025</length></cylinder></geometry>
        <surface>
          <friction>
            <ode><mu>1.2</mu><mu2>0.3</mu2><fdir1>1 0 0</fdir1><slip1>0.01</slip1><slip2>0.02</slip2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="rf_visual"><geometry><mesh><uri>model://wheeltec_robot/meshes/rf_link.STL</uri></mesh></geometry><material><ambient>0.012 0.015 0.020 1</ambient><diffuse>0.025 0.032 0.042 1</diffuse><specular>0.12 0.16 0.20 1</specular><shininess>35</shininess></material></visual>
      <visual name="rf_hub"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.012</radius><length>0.028</length></cylinder></geometry><material><ambient>0.28 0.32 0.36 1</ambient><diffuse>0.52 0.58 0.64 1</diffuse><specular>0.90 0.95 1.00 1</specular><shininess>90</shininess></material></visual>
    </link>
    <joint name="left_joint" type="fixed"><parent>base_link</parent><child>left_link</child></joint>
    <joint name="right_joint" type="fixed"><parent>base_link</parent><child>right_link</child></joint>
    <joint name="lf_point" type="revolute"><parent>base_link</parent><child>lf_link</child><axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit><dynamics><damping>0.01</damping><friction>0.0</friction></dynamics></axis></joint>
    <joint name="rf_point" type="revolute"><parent>base_link</parent><child>rf_link</child><axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit><dynamics><damping>0.01</damping><friction>0.0</friction></dynamics></axis></joint>

    <link name="laser_link">
      <pose>0.051343 -0.000013 0.094524 0 0 3.1416</pose>
      <visual name="laser_visual"><geometry><mesh><uri>model://wheeltec_robot/meshes/laser.STL</uri></mesh></geometry><material><ambient>0.16 0.19 0.22 1</ambient><diffuse>0.32 0.38 0.44 1</diffuse><specular>0.92 0.96 1.00 1</specular><shininess>95</shininess></material></visual>
      <sensor name="laser" type="gpu_lidar">
        <always_on>true</always_on><update_rate>8</update_rate><topic>/scan</topic><gz_frame_id>laser_link</gz_frame_id><visualize>true</visualize>
        <ray><scan><horizontal><samples>240</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan><range><min>0.03</min><max>8.0</max><resolution>0.01</resolution></range><noise><type>gaussian</type><mean>0</mean><stddev>0.002</stddev></noise></ray>
      </sensor>
    </link>
    <joint name="laser_joint" type="fixed"><parent>base_link</parent><child>laser_link</child></joint>

    <link name="camera_link">
      <pose>0.11365 0.000165 0.076204 0 0 0</pose>
      <sensor name="front_camera" type="camera">
        <always_on>true</always_on><update_rate>4</update_rate><topic>/camera/image_raw</topic><gz_frame_id>camera_link</gz_frame_id><visualize>true</visualize>
        <camera name="front_camera"><horizontal_fov>1.0472</horizontal_fov><image><width>320</width><height>180</height><format>R8G8B8</format></image><clip><near>0.01</near><far>12.0</far></clip></camera>
      </sensor>
    </link>
    <joint name="camera_joint" type="fixed"><parent>base_link</parent><child>camera_link</child></joint>

    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>lb_joint</left_joint><left_joint>lf_point</left_joint>
      <right_joint>rb_joint</right_joint><right_joint>rf_point</right_joint>
      <wheel_separation>0.1595</wheel_separation><wheel_radius>0.033</wheel_radius>
      <topic>/cmd_vel</topic><odom_topic>/odom</odom_topic><tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id><child_frame_id>base_link</child_frame_id><odom_publish_frequency>30</odom_publish_frequency>
      <max_linear_acceleration>1.0</max_linear_acceleration><min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_angular_acceleration>5.0</max_angular_acceleration><min_angular_acceleration>-5.0</min_angular_acceleration>
      <max_linear_velocity>10.0</max_linear_velocity><min_linear_velocity>-10.0</min_linear_velocity>
      <max_angular_velocity>3.0</max_angular_velocity><min_angular_velocity>-3.0</min_angular_velocity>
    </plugin>
  </model>
</sdf>
