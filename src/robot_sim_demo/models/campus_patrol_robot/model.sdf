<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="campus_patrol_robot">
    <static>false</static>
    <self_collide>false</self_collide>
    <allow_auto_disable>false</allow_auto_disable>

    <link name="base_footprint">
      <pose>0 0 -0.145 0 0 0</pose>
    </link>
    <link name="base_link">
      <inertial>
        <mass>5.0</mass>
        <inertia><ixx>0.09</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.12</iyy><iyz>0</iyz><izz>0.18</izz></inertia>
      </inertial>
      <collision name="body_collision"><geometry><box><size>0.46 0.34 0.14</size></box></geometry></collision>
      <visual name="body_visual"><geometry><box><size>0.46 0.34 0.14</size></box></geometry><material><ambient>0.04 0.05 0.07 1</ambient><diffuse>0.10 0.12 0.16 1</diffuse><specular>0.20 0.22 0.26 1</specular></material></visual>
      <visual name="upper_deck"><pose>-0.05 0 0.09 0 0 0</pose><geometry><box><size>0.30 0.28 0.06</size></box></geometry><material><ambient>0.09 0.10 0.13 1</ambient><diffuse>0.16 0.18 0.22 1</diffuse></material></visual>
      <visual name="front_status_light"><pose>0.235 0 0 0 0 0</pose><geometry><box><size>0.03 0.30 0.07</size></box></geometry><material><emissive>0.90 0.22 0.02 1</emissive><diffuse>1.00 0.38 0.05 1</diffuse></material></visual>
      <visual name="cyan_outline_left"><pose>0 0.176 0.04 0 0 0</pose><geometry><box><size>0.34 0.012 0.04</size></box></geometry><material><emissive>0.02 0.38 0.56 1</emissive><diffuse>0.05 0.78 0.98 1</diffuse></material></visual>
      <visual name="cyan_outline_right"><pose>0 -0.176 0.04 0 0 0</pose><geometry><box><size>0.34 0.012 0.04</size></box></geometry><material><emissive>0.02 0.38 0.56 1</emissive><diffuse>0.05 0.78 0.98 1</diffuse></material></visual>
      <visual name="beacon_light"><pose>0 0 0.32 0 0 0</pose><geometry><cylinder><radius>0.05</radius><length>0.28</length></cylinder></geometry><material><emissive>0.85 0.18 0.02 1</emissive><diffuse>1.00 0.32 0.04 1</diffuse></material></visual>
      <visual name="beacon_tip"><pose>0 0 0.46 0 0 0</pose><geometry><sphere><radius>0.08</radius></sphere></geometry><material><emissive>1.00 0.30 0.03 1</emissive><diffuse>1.00 0.48 0.08 1</diffuse></material></visual>
    </link>

    <link name="wheel_left_link">
      <pose>0 0.20 -0.08 -1.5708 0 0</pose>
      <inertial><mass>0.25</mass><inertia><ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.001</iyy><iyz>0</iyz><izz>0.001</izz></inertia></inertial>
      <collision name="wheel_left_collision"><geometry><cylinder><radius>0.065</radius><length>0.04</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2><slip1>0.02</slip1><slip2>0.0</slip2><fdir1>1 0 0</fdir1></ode></friction></surface></collision>
      <visual name="wheel_left_visual"><geometry><cylinder><radius>0.065</radius><length>0.04</length></cylinder></geometry><material><diffuse>0.01 0.012 0.016 1</diffuse></material></visual>
    </link>
    <link name="wheel_right_link">
      <pose>0 -0.20 -0.08 -1.5708 0 0</pose>
      <inertial><mass>0.25</mass><inertia><ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.001</iyy><iyz>0</iyz><izz>0.001</izz></inertia></inertial>
      <collision name="wheel_right_collision"><geometry><cylinder><radius>0.065</radius><length>0.04</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2><slip1>0.02</slip1><slip2>0.0</slip2><fdir1>1 0 0</fdir1></ode></friction></surface></collision>
      <visual name="wheel_right_visual"><geometry><cylinder><radius>0.065</radius><length>0.04</length></cylinder></geometry><material><diffuse>0.01 0.012 0.016 1</diffuse></material></visual>
    </link>
    <link name="caster_link">
      <pose>-0.18 0 -0.10 0 0 0</pose>
      <inertial><mass>0.05</mass><inertia><ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0001</iyy><iyz>0</iyz><izz>0.0001</izz></inertia></inertial>
      <collision name="caster_collision"><geometry><sphere><radius>0.045</radius></sphere></geometry></collision>
      <visual name="caster_visual"><geometry><sphere><radius>0.045</radius></sphere></geometry><material><diffuse>0.01 0.012 0.016 1</diffuse></material></visual>
    </link>
    <link name="laser_link">
      <pose>0.10 0 0.12 0 0 0</pose>
      <inertial><mass>0.12</mass><inertia><ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.001</iyy><iyz>0</iyz><izz>0.001</izz></inertia></inertial>
      <visual name="laser_housing"><geometry><cylinder><radius>0.075</radius><length>0.06</length></cylinder></geometry><material><diffuse>0.015 0.018 0.022 1</diffuse></material></visual>
      <visual name="laser_status"><pose>0 0 0.035 0 0 0</pose><geometry><cylinder><radius>0.055</radius><length>0.012</length></cylinder></geometry><material><emissive>0.02 0.38 0.56 1</emissive><diffuse>0.05 0.78 0.98 1</diffuse></material></visual>
      <sensor name="laser" type="gpu_lidar">
        <always_on>true</always_on>
        <update_rate>5</update_rate>
        <topic>/scan</topic>
        <gz_frame_id>laser_link</gz_frame_id>
         <visualize>true</visualize>
        <ray>
          <scan><horizontal><samples>180</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
          <range><min>0.08</min><max>8.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.005</stddev></noise>
        </ray>
      </sensor>
    </link>
    <link name="camera_link">
      <pose>0.31 0 0.20 0 0 0</pose>
      <visual name="camera_visual"><geometry><box><size>0.05 0.12 0.05</size></box></geometry><material><diffuse>0.01 0.012 0.016 1</diffuse></material></visual>
      <sensor name="front_camera" type="camera">
        <always_on>true</always_on>
        <update_rate>3</update_rate>
        <topic>/camera/image_raw</topic>
        <gz_frame_id>camera_link</gz_frame_id>
        <camera name="front_camera">
          <horizontal_fov>1.0472</horizontal_fov>
          <image><width>320</width><height>180</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>12.0</far></clip>
        </camera>
      </sensor>
    </link>

    <joint name="base_joint" type="fixed"><parent>base_link</parent><child>base_footprint</child></joint>
    <joint name="wheel_left_joint" type="revolute"><parent>base_link</parent><child>wheel_left_link</child><axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>
    <joint name="wheel_right_joint" type="revolute"><parent>base_link</parent><child>wheel_right_link</child><axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>
    <joint name="caster_joint" type="ball"><parent>base_link</parent><child>caster_link</child></joint>
    <joint name="laser_joint" type="fixed"><parent>base_link</parent><child>laser_link</child></joint>
    <joint name="camera_joint" type="fixed"><parent>base_link</parent><child>camera_link</child></joint>

    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>0.40</wheel_separation>
      <wheel_radius>0.065</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
      <max_linear_acceleration>0.8</max_linear_acceleration>
      <min_linear_acceleration>-0.8</min_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <min_angular_acceleration>-2.0</min_angular_acceleration>
      <max_linear_velocity>0.35</max_linear_velocity>
      <min_linear_velocity>-0.35</min_linear_velocity>
      <max_angular_velocity>0.9</max_angular_velocity>
      <min_angular_velocity>-0.9</min_angular_velocity>
    </plugin>

  </model>
</sdf>
