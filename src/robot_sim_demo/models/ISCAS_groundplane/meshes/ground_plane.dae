<?xml version="1.0" encoding="utf-8"?>
<COLLADA xmlns="http://www.collada.org/2005/11/COLLADASchema" version="1.4.1">
  <asset>
    <contributor>
      <author>OpenAI Codex</author>
      <authoring_tool>Manual export</authoring_tool>
    </contributor>
    <created>2026-04-29T00:00:00Z</created>
    <modified>2026-04-29T00:00:00Z</modified>
    <unit name="meter" meter="1"/>
    <up_axis>Z_UP</up_axis>
  </asset>

  <library_images>
    <image id="ground_plane_texture" name="ground_plane_texture">
      <init_from>ISCAS_groundplane.png</init_from>
    </image>
  </library_images>

  <library_effects>
    <effect id="ground_plane_effect">
      <profile_COMMON>
        <newparam sid="ground_plane_surface">
          <surface type="2D">
            <init_from>ground_plane_texture</init_from>
          </surface>
        </newparam>
        <newparam sid="ground_plane_sampler">
          <sampler2D>
            <source>ground_plane_surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <phong>
            <emission>
              <color>0 0 0 1</color>
            </emission>
            <ambient>
              <color>1 1 1 1</color>
            </ambient>
            <diffuse>
              <texture texture="ground_plane_sampler" texcoord="UVMap"/>
            </diffuse>
            <specular>
              <color>0.05 0.05 0.05 1</color>
            </specular>
            <shininess>
              <float>2.0</float>
            </shininess>
            <index_of_refraction>
              <float>1.0</float>
            </index_of_refraction>
          </phong>
        </technique>
      </profile_COMMON>
    </effect>
  </library_effects>

  <library_materials>
    <material id="ground_plane_material" name="ground_plane_material">
      <instance_effect url="#ground_plane_effect"/>
    </material>
  </library_materials>

  <library_geometries>
    <geometry id="ground_plane_geometry" name="ground_plane_geometry">
      <mesh>
        <source id="ground_plane_positions">
          <float_array id="ground_plane_positions_array" count="12">-15 -15 0 15 -15 0 15 15 0 -15 15 0</float_array>
          <technique_common>
            <accessor source="#ground_plane_positions_array" count="4" stride="3">
              <param name="X" type="float"/>
              <param name="Y" type="float"/>
              <param name="Z" type="float"/>
            </accessor>
          </technique_common>
        </source>
        <source id="ground_plane_normals">
          <float_array id="ground_plane_normals_array" count="3">0 0 1</float_array>
          <technique_common>
            <accessor source="#ground_plane_normals_array" count="1" stride="3">
              <param name="X" type="float"/>
              <param name="Y" type="float"/>
              <param name="Z" type="float"/>
            </accessor>
          </technique_common>
        </source>
        <source id="ground_plane_uvs">
          <float_array id="ground_plane_uvs_array" count="8">0 0 10 0 10 10 0 10</float_array>
          <technique_common>
            <accessor source="#ground_plane_uvs_array" count="4" stride="2">
              <param name="S" type="float"/>
              <param name="T" type="float"/>
            </accessor>
          </technique_common>
        </source>
        <vertices id="ground_plane_vertices">
          <input semantic="POSITION" source="#ground_plane_positions"/>
        </vertices>
        <triangles count="2" material="ground_plane_material">
          <input semantic="VERTEX" source="#ground_plane_vertices" offset="0"/>
          <input semantic="NORMAL" source="#ground_plane_normals" offset="1"/>
          <input semantic="TEXCOORD" source="#ground_plane_uvs" offset="2" set="0"/>
          <p>0 0 0 1 0 1 2 0 2 0 0 0 2 0 2 3 0 3</p>
        </triangles>
      </mesh>
    </geometry>
  </library_geometries>

  <library_visual_scenes>
    <visual_scene id="Scene" name="Scene">
      <node id="ground_plane_node" name="ground_plane_node" type="NODE">
        <instance_geometry url="#ground_plane_geometry">
          <bind_material>
            <technique_common>
              <instance_material symbol="ground_plane_material" target="#ground_plane_material">
                <bind_vertex_input semantic="UVMap" input_semantic="TEXCOORD" input_set="0"/>
              </instance_material>
            </technique_common>
          </bind_material>
        </instance_geometry>
      </node>
    </visual_scene>
  </library_visual_scenes>

  <scene>
    <instance_visual_scene url="#Scene"/>
  </scene>
</COLLADA>
